<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Scripts>
        <Script file="Source/View/StockPiler2Window.lua" />
    </Scripts>
    <Windows>
        <Window name="StockPiler2Window" movable="true" savesettings="true" layer="secondary">
            <Size>
                <AbsPoint x="1040" y="720" />
            </Size>
            <Anchors>
                <Anchor point="center" relativePoint="center" />
            </Anchors>
            <EventHandlers>
                <EventHandler event="OnInitialize" function="StockPiler2Window.OnInitialize" />
                <EventHandler event="OnShown" function="StockPiler2Window.OnShow" />
                <EventHandler event="OnHidden" function="WindowUtils.OnHidden" />
                <EventHandler event="OnKeyEscape" function="StockPiler2Window.OnClose" />
            </EventHandlers>
            <Windows>
                <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" />
                <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
                <DynamicImage name="$parentWindowImage" inherits="EA_Default_SettingsImage" />
                <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="StockPiler2Window.OnClose" />
                    </EventHandlers>
                </Button>

                <Window name="$parentButtonBackground" inherits="EA_Window_DefaultButtonBottomFrame" layer="background">
                    <Size>
                        <AbsPoint x="0" y="75" />
                    </Size>
                </Window>

                <!-- Tabs -->
                <Window name="$parentTabButtons">
                    <Size>
                        <AbsPoint x="1000" y="35" />
                    </Size>
                    <Anchors>
                        <Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTitleBar" />
                        <Anchor point="bottomright" relativePoint="topright" relativeTo="$parentTitleBar" />
                    </Anchors>
                    <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_MetalFill">
                        <Anchors>
                            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
                            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
                        </Anchors>
                    </FullResizeImage>
                    <Windows>
                        <Window name="$parentSeparatorLeft" inherits="EA_Window_TabSeparatorLeftSide" layer="background" popable="false">
                            <Anchors>
                                <Anchor point="bottomleft" relativePoint="bottomleft">
                                    <AbsPoint x="0" y="-6" />
                                </Anchor>
                                <Anchor point="bottomleft" relativePoint="topright" relativeTo="$parentPotions">
                                    <AbsPoint x="0" y="-6" />
                                </Anchor>
                            </Anchors>
                        </Window>

                        <Button name="$parentPotions" inherits="StockPiler2_Templates_TabButton" id="1">
                            <Anchors>
                                <Anchor point="topleft" relativePoint="topleft">
                                    <AbsPoint x="25" y="0" />
                                </Anchor>
                            </Anchors>
                        </Button>
                        <Button name="$parentWatch" inherits="StockPiler2_Templates_TabButton" id="2">
                            <Anchors>
                                <Anchor point="right" relativePoint="left" relativeTo="$parentPotions">
                                    <AbsPoint x="0" y="0" />
                                </Anchor>
                            </Anchors>
                        </Button>

                        <Window name="$parentSeparatorRight" inherits="EA_Window_TabSeparatorRightSide" layer="background" popable="false">
                            <Anchors>
                                <Anchor point="bottomright" relativePoint="topleft" relativeTo="$parentWatch">
                                    <AbsPoint x="0" y="-6" />
                                </Anchor>
                                <Anchor point="bottomright" relativePoint="bottomright">
                                    <AbsPoint x="0" y="-6" />
                                </Anchor>
                            </Anchors>
                        </Window>
                    </Windows>
                </Window>

                <Window name="StockPiler2WindowSocket" handleinput="false" popable="false">
                    <Anchors>
                        <Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentTabButtons">
                            <AbsPoint x="15" y="15" />
                        </Anchor>
                        <Anchor point="topright" relativePoint="bottomright" relativeTo="$parentButtonBackground">
                            <AbsPoint x="-5" y="10" />
                        </Anchor>
                    </Anchors>
                </Window>

                <Window name="SP2TabPotions" inherits="StockPiler2TabPotions">
                    <EventHandlers>
                        <EventHandler event="OnInitialize" function="StockPiler2TabPotions.Initialize" />
                    </EventHandlers>
                </Window>
                <Window name="SP2TabWatch" inherits="StockPiler2TabWatch" />

                <Button name="$parentClearWatches" inherits="EA_Button_DefaultResizeable">
                    <Anchors>
                        <Anchor point="bottom" relativePoint="bottom" relativeTo="StockPiler2Window">
                            <AbsPoint x="0" y="-10" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="StockPiler2Window.OnClearWatches" />
                        <EventHandler event="OnMouseOver" function="StockPiler2Window.OnMouseOverClearWatches" />
                    </EventHandlers>
                </Button>
                <Button name="$parentHarvest" inherits="EA_Button_DefaultResizeable" gameactionbutton="left">
                    <Anchors>
                        <Anchor point="bottom" relativePoint="bottom" relativeTo="StockPiler2Window">
                            <AbsPoint x="0" y="-10" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonDown" function="StockPiler2Window.OnHarvestPrepare" />
                        <EventHandler event="OnLButtonUp" function="StockPiler2Window.OnHarvest" />
                        <EventHandler event="OnMouseOver" function="StockPiler2Window.OnMouseOverHarvest" />
                    </EventHandlers>
                </Button>
            </Windows>
        </Window>
    </Windows>
</Interface>
